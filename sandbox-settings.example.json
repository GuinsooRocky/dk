{
  "_comment_1": "两层闸，缺一层就有洞（为什么见 SANDBOX.md）：",
  "_comment_2": "sandbox.* = OS 层 Seatbelt，只包 Bash 起的子进程；claude 自己的进程不在里面",
  "_comment_3": "permissions.deny = 进程内层，管 claude 自己的 Read/Grep —— 它们读不到 sandbox.denyRead",
  "_comment_4": "permissions 路径写法：// 开头=绝对路径，不吃 ~ 展开；sandbox 段那边可以用 ~",
  "_comment_5": "改完必须跑 bash scripts/sandbox-probe.sh —— 规则名写错会被静默忽略，看配置看不出来",

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "_autoAllow_note": "必须 false —— 它的意思是「已经在沙箱里了，Bash 免提示跑」，正好把审批链路旁路掉（实测 true 时 permission-prompt-tool 压根不被调用）。要审批就不能免提示。",
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/claude-hub-workdir",
        "~/claude-feishu-workdir",
        "~/claude-telegram-workdir",
        "/tmp",
        "/private/tmp"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.gnupg",
        "~/.netrc",
        "~/.zshrc",
        "~/.claude.json",
        "~/Library/Keychains",
        "~/Library/Cookies"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "statsig.anthropic.com",
        "console.anthropic.com",
        "open.feishu.cn",
        "*.feishu.cn"
      ],
      "allowManagedDomainsOnly": true
    }
  },

  "permissions": {
    "_ask_note": "ask 命中的工具会去问 --permission-prompt-tool（审批链路）。没开审批时它们直接被拒 = fail-closed。按能力列全，别只列 Bash：实测 deny 掉 Bash 后 claude 会改用 Monitor 跑同一条命令。",
    "ask": [
      "Bash", "BashOutput", "KillShell", "Monitor",
      "Task", "Agent",
      "Write", "Edit", "MultiEdit", "NotebookEdit"
    ],
    "deny": [
      "Read(//Users/你/.ssh/**)",
      "Read(//Users/你/.aws/**)",
      "Read(//Users/你/.config/gh/**)",
      "Read(//Users/你/.gnupg/**)",
      "Read(//Users/你/.netrc)",
      "Read(//Users/你/.zshrc)",
      "Read(//Users/你/.zsh_history)",
      "Read(//Users/你/.claude.json)",
      "Read(//Users/你/Library/Keychains/**)",
      "Read(//Users/你/Library/Cookies/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Grep(//Users/你/.ssh/**)",
      "Grep(//Users/你/.aws/**)",
      "Grep(//Users/你/.config/gh/**)",
      "Grep(//**/.env)"
    ]
  }
}
