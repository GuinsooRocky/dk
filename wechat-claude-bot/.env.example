# ========================================
# Claude Bridge (Python)
# ========================================
# 用本机 claude 订阅登录则不需要；用 API key 才填
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx

# 桥接服务端口（默认 5858）
BRIDGE_PORT=5858

# Claude 工作目录（默认 ~/claude-wechat-workdir）
# 注意：cwd 不是安全沙箱，开了 Bash 仍能读写全盘，真隔离见 README
CLAUDE_WORK_DIR=/Users/your_name/claude-wechat-workdir

# 安全默认：只读工具。开 Bash/Write/Edit = 微信消息可能拿到 shell，务必配合沙箱（见 README）
CLAUDE_TOOLS=Read,Glob,Grep,WebFetch

# 单次任务超时（秒）
CLAUDE_TIMEOUT=300

# 同时最多跑几个 claude（1=单飞，忙时回"稍等"，防并发 fork 爆内存）
CLAUDE_MAX_CONCURRENCY=1

# 微信用户白名单（昵称，逗号分隔）。⚠ fail-closed：留空 = 拒绝所有人！
# 例：ALLOWED_USERS=张三,李四
ALLOWED_USERS=

# claude 命令路径（如果 claude 不在 PATH 里）
# CLAUDE_CMD=/Users/your_name/.claude/local/claude

# ========================================
# WeChat Bot (Node)
# ========================================
BRIDGE_URL=http://127.0.0.1:5858/chat

# 私聊触发前缀（带尾随空格更精确，避免 /code、/clear 等被误当触发词；
# 必须加引号，否则 dotenv 会把尾随空格 trim 掉）
TRIGGER_PREFIX="/c "

# Bot 名字（用于 wechaty 的 session 文件名）
BOT_NAME=claude-bot

# 群里是否需要 @机器人 才回复
GROUP_REQUIRE_MENTION=true
