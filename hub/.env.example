# ========================================
# Hub（唯一大脑，HTTP 服务）
# ========================================
HUB_PORT=8787

# ========================================
# Claude 执行（复用 core；这里的单飞是【全局】单飞）
# ========================================
# 安全默认：只读工具。开 Bash/Write/Edit 见 ../SANDBOX.md
CLAUDE_TOOLS=Read,Glob,Grep,WebFetch

# 全局同时最多几个 claude（1=单飞，跨所有渠道生效，防爆内存）
CLAUDE_MAX_CONCURRENCY=1

# 单次任务超时（秒）
CLAUDE_TIMEOUT=300

# 执行引擎：cli（默认）| sdk
# 注：审批链路只在 cli 路径实现；开了审批又设 sdk 会被拒跑（fail-closed，不静默无闸执行）
CLAUDE_ENGINE=cli

# 沙箱配置文件（两层闸，见 ../SANDBOX.md）。改完跑 scripts/sandbox-probe.sh 验
# CLAUDE_SETTINGS=/Users/你/Desktop/my-code/dk/sandbox-settings.json

# 审批链路：关=危险工具直接不给（fail-closed）；开=给但每次推 Telegram 按钮问你
# 开之前跑 scripts/approval-e2e.sh，三个用例要全过
# DK_APPROVALS=1
# DK_APPROVAL_BUDGET_SEC=1800

# claude 命令路径（不在 PATH 时填绝对路径）
# CLAUDE_CMD=/Users/你/.local/bin/claude

# 注：白名单 ALLOWED_USERS 不在 Hub，放在各渠道壳（平台 id 格式不同）；
# Hub 绑 127.0.0.1 只本机可达，渠道壳先挡未授权再 POST 过来。
