# =====================================================
# 方案 A：单向（终端 → 群）feishu_send.py 用
# =====================================================
# 群机器人 webhook（设置 → 群机器人 → 添加自定义机器人）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的token
# 可选：群机器人签名校验密钥
FEISHU_SECRET=

# =====================================================
# 方案 B：双向（群里 @ 机器人 → Claude → 回复）feishu_app_server.py 用
# =====================================================
# 在 https://open.feishu.cn 创建"企业自建应用"后获得
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# "事件订阅"页面里填的加密密钥（建议设，更安全）
FEISHU_ENCRYPT_KEY=
# "事件订阅"页面里的 Verification Token（强烈建议设：webhook 的鉴权层）
FEISHU_VERIFY_TOKEN=
# 机器人自身 open_id（留空则启动时自动调 /bot/v3/info 获取，用于严格判断是否 @ 了本机器人）
FEISHU_BOT_OPEN_ID=
# 服务器监听端口（ngrok 转发到 127.0.0.1:此端口）
APP_PORT=5858

# =====================================================
# 共用：Claude Code 配置
# =====================================================
# 用本机 claude 订阅登录则不需要填；用 API key 才填
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
CLAUDE_WORK_DIR=/Users/你的名字/claude-feishu-workdir
# 安全默认：只读工具。开 Bash/Write/Edit = 聊天消息可能拿到 shell，务必配合沙箱（见 README）
CLAUDE_TOOLS=Read,Glob,Grep,WebFetch
CLAUDE_TIMEOUT=300
# 同时最多跑几个 claude（1=单飞，忙时回"稍等"，防并发 fork 爆内存）
CLAUDE_MAX_CONCURRENCY=1
# 执行引擎：cli（默认，subprocess 调 claude -p）| sdk（进程内 claude-agent-sdk，需 pip 装）
CLAUDE_ENGINE=cli
# sandbox 隔离配置文件（见 SANDBOX.md），配了才会以 --settings 套用到 bot 起的 claude
# CLAUDE_SETTINGS=/Users/你的名字/Desktop/my-code/chat-cc-bot/sandbox-settings.json
# CLAUDE_CMD=/Users/你的名字/.claude/local/claude

# 用户白名单（open_id，逗号分隔）。⚠ fail-closed：留空 = 拒绝所有人！
# 先发一条消息从 server 日志拿到你的 open_id，填进来再重启
ALLOWED_USERS=
