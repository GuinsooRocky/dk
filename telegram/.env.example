# ========================================
# Telegram Bot
# ========================================
# Telegram 里找 @BotFather → /newbot 拿到，必填
TELEGRAM_BOT_TOKEN=

# 群里触发前缀（带尾随空格更精确）。私聊默认所有文本都回，不需要前缀
TRIGGER_PREFIX="/c "

# ========================================
# Claude 执行（与 feishu/wecom 同款，全部复用 core）
# ========================================
# 白名单（Telegram 数字 user id，逗号分隔）。⚠ fail-closed：留空 = 拒绝所有人！
# 先留空，第一次私聊 bot 后从日志的 from=xxx 拿真实 user id 回填再重启
ALLOWED_USERS=

# 安全默认：只读工具。开 Bash/Write/Edit = 消息可能拿到 shell，务必配合沙箱（见 ../SANDBOX.md）
CLAUDE_TOOLS=Read,Glob,Grep,WebFetch

# 同时最多跑几个 claude（1=单飞，忙时回"稍等"，防爆内存）
CLAUDE_MAX_CONCURRENCY=1

# 单次任务超时（秒）
CLAUDE_TIMEOUT=300

# 执行引擎：cli（默认，subprocess）| sdk（进程内 claude-agent-sdk）
CLAUDE_ENGINE=cli

# Claude 工作目录（默认 ~/claude-telegram-workdir）
# 注意：cwd 不是安全沙箱，开了 Bash 仍能读写全盘，真隔离见 ../SANDBOX.md
# CLAUDE_WORK_DIR=/Users/你/claude-telegram-workdir

# claude 命令路径（不在 PATH 时填绝对路径）
# CLAUDE_CMD=/Users/你/.local/bin/claude

# sandbox 隔离配置（见 ../SANDBOX.md），配了才以 --settings 套用
# CLAUDE_SETTINGS=/Users/你/Desktop/my-code/chat-cc-bot/sandbox-settings.json
